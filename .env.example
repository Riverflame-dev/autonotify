# Copy to .env and fill in. .env is gitignored.

# ntfy topic — anyone who knows this can read your notifications, so keep it private & random.
NTFY_TOPIC=

# Anthropic API key — ONLY needed if you set stage2.backend=api in config.yaml.
# The default (stage2.backend=claude_cli) uses your Claude subscription via `claude -p`
# and needs NO key. Leave this blank unless you switch to the paid API backend.
ANTHROPIC_API_KEY=
